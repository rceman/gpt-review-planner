{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent evidence with compatibility attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "implementation_commit",
    "requirements",
    "gates",
    "deviations",
    "compatibility_scope",
    "compatibility_authorized",
    "compatibility_features_added",
    "legacy_paths_added",
    "fallbacks_added",
    "migration_behavior_added"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "implementation_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "requirements": {
      "type": "array"
    },
    "gates": {
      "type": "array"
    },
    "deviations": {
      "type": "array"
    },
    "compatibility_scope": {
      "const": "none"
    },
    "compatibility_authorized": {
      "const": false
    },
    "compatibility_features_added": {
      "type": "array",
      "maxItems": 0
    },
    "legacy_paths_added": {
      "type": "array",
      "maxItems": 0
    },
    "fallbacks_added": {
      "type": "array",
      "maxItems": 0
    },
    "migration_behavior_added": {
      "type": "array",
      "maxItems": 0
    }
  }
}
