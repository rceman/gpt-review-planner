{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent evidence with compatibility attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "implementation_commit",
    "requirements",
    "gates",
    "deviations",
    "compatibility_scope",
    "compatibility_authorized",
    "compatibility_features_added",
    "legacy_paths_added",
    "fallbacks_added",
    "migration_behavior_added"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "implementation_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "requirements": {
      "type": "array"
    },
    "gates": {
      "type": "array"
    },
    "deviations": {
      "type": "array"
    },
    "compatibility_scope": {"type":"string","minLength":1},
    "compatibility_authorized": {"type":"boolean"},
    "compatibility_features_added": {
      "type": "array",
      "items":{"type":"string"}
    },
    "legacy_paths_added": {
      "type": "array",
      "items":{"type":"string"}
    },
    "fallbacks_added": {
      "type": "array",
      "items":{"type":"string"}
    },
    "migration_behavior_added": {
      "type": "array",
      "items":{"type":"string"}
    },
    "task_gate_contract": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "project_id", "task_id", "task_sha256", "required_gates", "contract_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "project_id": {"type":"string","minLength":1},
        "task_id": {"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "task_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
        "contract_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
        "required_gates": {"type":"array","minItems":1}
      }
    }
  }
}
