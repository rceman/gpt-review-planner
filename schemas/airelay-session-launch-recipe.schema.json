{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-review-planner.invalid/schemas/airelay-session-launch-recipe.schema.json",
  "title": "Airelay session launch recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_sha256",
    "session_key",
    "profile",
    "working_directory",
    "executable",
    "child",
    "resume",
    "approved_flags",
    "environment_references"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "recipe_sha256": {"$ref": "#/$defs/sha256"},
    "session_key": {"$ref": "#/$defs/sessionKey"},
    "profile": {"$ref": "#/$defs/identifier"},
    "working_directory": {"$ref": "#/$defs/absolutePath"},
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation_path", "resolved_path", "resolution_kind", "version", "controller_protocol_version"],
      "properties": {
        "invocation_path": {"$ref": "#/$defs/absolutePath"},
        "resolved_path": {"$ref": "#/$defs/absolutePath"},
        "resolution_kind": {"$ref": "#/$defs/resolutionKind"},
        "version": {"$ref": "#/$defs/semver"},
        "controller_protocol_version": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation_path", "resolved_path", "resolution_kind", "argv"],
      "properties": {
        "invocation_path": {"$ref": "#/$defs/absolutePath"},
        "resolved_path": {"$ref": "#/$defs/absolutePath"},
        "resolution_kind": {"$ref": "#/$defs/resolutionKind"},
        "argv": {"$ref": "#/$defs/argv"}
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity"],
      "properties": {
        "identity": {"$ref": "#/$defs/uuid"}
      }
    },
    "approved_flags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/flag"}
    },
    "environment_references": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/environmentReference"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "resolutionKind": {"enum": ["direct", "symlink", "wrapper"]},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "minLength": 1, "maxLength": 128},
    "sessionKey": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$", "minLength": 1, "maxLength": 128},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "positiveInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f\\\\])[^/]+(?:/[^/]+)*$",
      "minLength": 2,
      "maxLength": 4096
    },
    "shellSafeToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*[\\s\\u0000-\\u001f\\u007f;|&$\\x60\\x28\\x29<>]).+$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/shellSafeToken"}
    },
    "flag": {"type": "string", "pattern": "^--[A-Za-z0-9][A-Za-z0-9-]{0,63}$"},
    "environmentReference": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"}
  }
}
