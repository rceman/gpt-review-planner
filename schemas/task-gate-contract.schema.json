{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "task_id", "task_sha256", "required_gates"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "task_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "command", "argv", "env", "cwd", "parser", "metric", "timeout_seconds", "max_output_bytes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "env": {"type": "object", "additionalProperties": {"type": "string"}},
          "cwd": {"type": "string"},
          "parser": {"enum": ["exit", "unittest", "pytest"]},
          "metric": {"type": ["string", "null"]},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
          "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 16777216}
        }
      }
    }
  }
}
