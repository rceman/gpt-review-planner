{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rceman/gpt-review-planner/schemas/release-lifecycle-task.schema.json",
  "title": "Release lifecycle task declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lifecycle_mode", "target_version", "state_gate"],
  "properties": {
    "schema_version": {"const": 1},
    "lifecycle_mode": {"enum": ["implementation_unreleased", "release_publication"]},
    "target_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "state_gate": {"type": "string", "minLength": 1}
  }
}
