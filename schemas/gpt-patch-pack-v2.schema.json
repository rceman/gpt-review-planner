{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rceman/gpt-review-planner/schemas/gpt-patch-pack-v2.schema.json",
  "title": "GPT Patch Pack v2 Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "patch_id", "title", "description", "created_at", "runner_version", "baseline_release", "execution_mode", "workflow", "target", "payload", "files_created", "files_modified", "files_deleted", "target_tree", "requirements", "gates", "compatibility", "metadata"],
  "properties": {
    "schema_version": {"const": 2},
    "format": {"const": "gpt-patch-pack-v2"},
    "patch_id": {"type": "string", "pattern": "^patch-[0-9]{8}-[0-9]{6}-[a-z0-9](?:[a-z0-9-]{0,63})$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "runner_version": {"const": "2.0.0"},
    "baseline_release": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "execution_mode": {"enum": ["gpt_tunnel_managed", "repository_evidence"]},
    "evidence_directory": {"type": "string", "pattern": "^\\.gpt-review/evidence/"},
    "workflow": {"$ref": "#/$defs/workflow"},
    "target": {"$ref": "#/$defs/target"},
    "payload": {"const": {"patch": "payload/changes.patch", "format": "git-binary-full-index"}},
    "files_created": {"type": "array", "items": {"$ref": "#/$defs/path"}},
    "files_modified": {"type": "array", "items": {"$ref": "#/$defs/path"}},
    "files_deleted": {"type": "array", "items": {"$ref": "#/$defs/path"}},
    "target_tree": {"$ref": "#/$defs/sha"},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "metadata": {"$ref": "#/$defs/metadata"}
  },
  "allOf": [{"if": {"properties": {"execution_mode": {"const": "gpt_tunnel_managed"}}}, "then": {"not": {"required": ["evidence_directory"]}}}, {"if": {"properties": {"execution_mode": {"const": "repository_evidence"}}}, "then": {"required": ["evidence_directory"]}}],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(^|/)\\.\\.?(/|$))(?!.*\\\\).+$"},
    "workflow": {"type": "object", "additionalProperties": false, "required": ["repository", "version", "commit", "document"], "properties": {"repository": {"const": "https://github.com/rceman/gpt-review-planner"}, "version": {"type": "string"}, "commit": {"$ref": "#/$defs/sha"}, "document": {"const": "GPT_REVIEW_PLANNER.md"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["repository", "accepted_origin_urls", "branch", "base_revision", "remote", "remote_ref"], "properties": {"repository": {"type": "string", "minLength": 1}, "accepted_origin_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "branch": {"type": "string", "minLength": 1}, "base_revision": {"$ref": "#/$defs/sha"}, "remote": {"type": "string", "minLength": 1}, "remote_ref": {"type": "string", "pattern": "^refs/remotes/"}}},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["id", "summary", "acceptance"], "properties": {"id": {"type": "string", "pattern": "^REQ-[A-Za-z0-9][A-Za-z0-9-]*$"}, "summary": {"type": "string", "minLength": 1}, "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "gate": {"type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "argv", "env", "timeout_seconds", "max_output_bytes"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "kind": {"const": "command"}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "env": {"type": "object", "additionalProperties": {"type": "string"}}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200}, "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 16777216}}},
    "compatibility": {"type": "object", "additionalProperties": false, "required": ["scope", "authorized", "canonical_implementation", "legacy_behavior", "authorization_source", "supported_legacy_versions", "direction", "removal_condition"], "properties": {"scope": {"type": "string"}, "authorized": {"type": "boolean"}, "canonical_implementation": {"type": "string"}, "legacy_behavior": {"type": "string"}, "authorization_source": {"type": ["string", "null"]}, "supported_legacy_versions": {"type": "array", "items": {"type": "string"}}, "direction": {"enum": ["none", "forward", "backward", "bidirectional"]}, "removal_condition": {"type": ["string", "null"]}}},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["planner_commit", "gpt_static_checks_performed", "gpt_runtime_checks_not_performed"], "properties": {"planner_commit": {"$ref": "#/$defs/sha"}, "gpt_static_checks_performed": {"type": "array", "items": {"type": "string", "minLength": 1}}, "gpt_runtime_checks_not_performed": {"type": "array", "items": {"type": "string", "minLength": 1}}}}
  }
}
