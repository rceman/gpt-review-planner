{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GPT Patch Pack v1 Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "patch_id",
    "title",
    "description",
    "created_at",
    "runner_version",
    "baseline_release",
    "evidence_directory",
    "workflow",
    "target",
    "payload",
    "files_created",
    "files_modified",
    "files_deleted",
    "target_tree",
    "requirements",
    "gates",
    "compatibility",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "format": {
      "const": "gpt-patch-pack-v1"
    },
    "patch_id": {
      "type": "string",
      "pattern": "^patch-[0-9]{8}-[0-9]{6}-[a-z0-9]+(?:-[a-z0-9]+){0,2}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 3
    },
    "created_at": {
      "type": "string"
    },
    "runner_version": {
      "const": "1.0.0"
    },
    "baseline_release": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "evidence_directory": {
      "type": "string",
      "pattern": "^\\.gpt-review/evidence/v[^/]+/patch-"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "version",
        "commit",
        "document"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/rceman/gpt-review-planner"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "document": {
          "const": "GPT_REVIEW_PLANNER.md"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "accepted_origin_urls",
        "branch",
        "base_revision",
        "remote",
        "remote_ref"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "accepted_origin_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "remote_ref": {
          "type": "string",
          "pattern": "^refs/remotes/"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patch",
        "preflight",
        "apply",
        "success_marker"
      ],
      "properties": {
        "patch": {
          "const": "payload/changes.patch"
        },
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "argv",
            "env"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "apply": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "argv",
            "env"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "success_marker": {
          "const": "GPT_PATCH_PAYLOAD_APPLIED"
        }
      }
    },
    "files_created": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)(?!.*[\\u0000\\r\\n]).+$"
      }
    },
    "files_modified": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)(?!.*[\\u0000\\r\\n]).+$"
      }
    },
    "files_deleted": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)(?!.*[\\u0000\\r\\n]).+$"
      }
    },
    "target_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "argv",
          "env",
          "timeout_seconds",
          "max_output_bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "command"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7200
          },
          "max_output_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 16777216
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "authorized",
        "canonical_implementation",
        "legacy_behavior",
        "authorization_source",
        "supported_legacy_versions",
        "direction",
        "removal_condition"
      ],
      "properties": {
        "scope": {
          "const": "none"
        },
        "authorized": {
          "const": false
        },
        "canonical_implementation": {
          "type": "string",
          "minLength": 1
        },
        "legacy_behavior": {
          "const": "unsupported and out of scope"
        },
        "authorization_source": {
          "type": "null"
        },
        "supported_legacy_versions": {
          "type": "array",
          "maxItems": 0
        },
        "direction": {
          "const": "none"
        },
        "removal_condition": {
          "type": "null"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planner_commit",
        "gpt_static_checks_performed",
        "gpt_runtime_checks_not_performed"
      ],
      "properties": {
        "planner_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "gpt_static_checks_performed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gpt_runtime_checks_not_performed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
