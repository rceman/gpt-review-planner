{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rceman/gpt-review-planner/schemas/patch-manifest.schema.json",
  "title": "Executable Patch Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "title",
    "description",
    "created_at",
    "patch_timestamp",
    "patch_slug",
    "baseline_release",
    "evidence_directory",
    "workflow",
    "target",
    "files_created",
    "files_modified",
    "files_deleted",
    "requirements",
    "gates",
    "gpt_static_checks_performed",
    "gpt_runtime_checks_not_performed",
    "known_integration_risks",
    "forbidden_deviations"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "patch_id": {"type": "string", "pattern": "^patch-[0-9]{8}-[0-9]{6}-[a-z0-9]+(?:-[a-z0-9]+){0,2}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 80},
    "description": {"type": "string", "minLength": 3, "maxLength": 240},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "patch_timestamp": {"type": "string", "pattern": "^[0-9]{8}-[0-9]{6}$"},
    "patch_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+){0,2}$"},
    "baseline_release": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "evidence_directory": {"type": "string", "pattern": "^\\.gpt-review/evidence/v[^/]+/patch-[0-9]{8}-[0-9]{6}-[a-z0-9]+(?:-[a-z0-9]+){0,2}$"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "commit", "document"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "document": {"const": "GPT_REVIEW_PLANNER.md"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "base_revision"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "base_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "files_created": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "files_modified": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "files_deleted": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "acceptance"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "allow_na": {"type": "boolean"}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["command", "github-actions", "scope", "evidence"]},
          "command": {"type": "string", "minLength": 1},
          "workflow": {"type": "string", "minLength": 1},
          "head": {"enum": ["implementation", "evidence"]}
        }
      }
    },
    "gpt_static_checks_performed": {"type": "array", "items": {"type": "string"}},
    "gpt_runtime_checks_not_performed": {"type": "array", "items": {"type": "string"}},
    "known_integration_risks": {"type": "array", "items": {"type": "string"}},
    "forbidden_deviations": {"type": "array", "items": {"type": "string"}}
  }
}
